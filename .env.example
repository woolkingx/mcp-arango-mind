# Public sample configuration.
# Copy to .env for local use. Do not commit real credentials.

# ArangoDB connection
ARANGO_URL=http://127.0.0.1:8529
ARANGO_DB=_system
ARANGO_USERNAME=root
ARANGO_PASSWORD=

# Or use a bearer token instead of username/password.
# Keep the value in .env or your MCP host config, not in tracked files.
# ARANGO_TOKEN=

# Logging: silent | error | warn | info | debug | trace
ARANGO_LOG_LEVEL=info
