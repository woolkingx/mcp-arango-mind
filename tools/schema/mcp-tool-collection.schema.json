{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-tool-collection.schema.json",
  "title": "MCP Tool Collection",
  "description": "ArangoDB collection, document, and index category scoped to Collections, Documents, and Indexes tags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "payload"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["list", "search", "describe", "call"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "description": "OpenAPI operationId within Collections, Documents, or Indexes tags." },
        "params": { "type": "object" },
        "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
        "format": { "type": "string", "enum": ["json", "md"], "default": "md" }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "action": { "const": "search" } } }, "then": { "properties": { "payload": { "required": ["keywords"] } } } },
    { "if": { "properties": { "action": { "const": "describe" } } }, "then": { "properties": { "payload": { "required": ["target"] } } } },
    { "if": { "properties": { "action": { "const": "call" } } }, "then": { "properties": { "payload": { "required": ["target"] } } } }
  ],
  "x-tool": {
    "name": "mcp.tool.collection",
    "title": "MCP Tool Collection",
    "description": "ArangoDB collection, document, and index category scoped to Collections, Documents, and Indexes tags.",
    "target": "mcp.tool.collection",
    "actions": {
      "list":     { "handler": "categoryCollection.list",     "effect": "read",  "idempotent": true,  "openWorld": false, "evidence": "Collection-tag operation listing" },
      "search":   { "handler": "categoryCollection.search",   "effect": "read",  "idempotent": true,  "openWorld": false, "evidence": "Collection-tag operation matches" },
      "describe": { "handler": "categoryCollection.describe", "effect": "read",  "idempotent": true,  "openWorld": false, "evidence": "Collection-tag operation contract" },
      "call":     { "handler": "categoryCollection.call",     "effect": "write", "idempotent": false, "openWorld": true,  "evidence": "ArangoDB Collection operation response" }
    }
  }
}
