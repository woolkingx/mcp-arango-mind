{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-tool-atlas.schema.json",
  "title": "MCP Tool Atlas",
  "description": "Handbook-style projections over notes, edges, topology, and view readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "payload"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["list", "search", "describe", "call"],
      "description": "Small control verb for the atlas surface."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "description": "Atlas query profile id: atlas.index, atlas.focus, atlas.facets, atlas.viewpoints, or atlas.audit."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^notes/[^/]+$",
              "description": "Root note id for rooted atlas profiles."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Traversal depth for atlas.index."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Maximum profile result rows returned."
            },
            "viewpoints": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Optional viewpoint terms for atlas.viewpoints."
            },
            "weakBelow": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Coverage count below which a viewpoint is weak."
            }
          },
          "description": "Profile-specific read parameters. Atlas always reads the notes and edges collections."
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Search keywords for profile discovery."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum profile records or result rows returned."
        },
        "format": {
          "type": "string",
          "enum": ["json", "md"],
          "default": "md",
          "description": "Output format."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "search" } } },
      "then": { "properties": { "payload": { "required": ["keywords"] } } }
    },
    {
      "if": { "properties": { "action": { "const": "describe" } } },
      "then": { "properties": { "payload": { "required": ["target"] } } }
    },
    {
      "if": { "properties": { "action": { "const": "call" } } },
      "then": { "properties": { "payload": { "required": ["target"] } } }
    }
  ],
  "x-tool": {
    "name": "mcp.tool.atlas",
    "title": "MCP Atlas Owner",
    "description": "Handbook-style projections over notes, edges, topology, and view readiness.",
    "target": "mcp.tool.atlas",
    "actions": {
      "list": {
        "handler": "atlasOwner.list",
        "effect": "read",
        "idempotent": true,
        "openWorld": false,
        "evidence": "Atlas query profile listing"
      },
      "search": {
        "handler": "atlasOwner.search",
        "effect": "read",
        "idempotent": true,
        "openWorld": false,
        "evidence": "Atlas query profile keyword matches"
      },
      "describe": {
        "handler": "atlasOwner.describe",
        "effect": "read",
        "idempotent": true,
        "openWorld": false,
        "evidence": "Atlas query profile contract"
      },
      "call": {
        "handler": "atlasOwner.call",
        "effect": "read",
        "idempotent": true,
        "openWorld": true,
        "evidence": "Atlas projection query result"
      }
    }
  }
}
