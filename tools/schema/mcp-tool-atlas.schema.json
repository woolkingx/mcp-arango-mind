{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-tool-atlas.schema.json",
  "title": "MCP Tool Atlas",
  "description": "Handbook-style projections over notes, edges, topology, and view readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "payload"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "search",
        "describe",
        "call"
      ],
      "description": "Small control verb for the atlas surface."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "description": "Atlas query profile id: atlas.index, atlas.focus, atlas.facets, atlas.types, atlas.viewpoints, or atlas.audit."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "pattern": "^notes/[^/]+$",
              "description": "Root note id for rooted graph profiles, or type prefix array for atlas.types."
            },
            "mode": {
              "type": "string",
              "enum": [
                "table",
                "suggest",
                "tree"
              ],
              "default": "table",
              "description": "View mode for atlas.types."
            },
            "query": {
              "type": "string",
              "description": "Optional phrase for atlas.types suggest mode."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional tag hints for atlas.types suggest mode."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Traversal depth for atlas.index or atlas.types tree mode."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Maximum profile result rows returned."
            },
            "examples": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "description": "Maximum example note titles per atlas.types row."
            },
            "viewpoints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Optional viewpoint terms for atlas.viewpoints."
            },
            "weakBelow": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Coverage count below which a viewpoint is weak."
            }
          },
          "description": "Profile-specific read parameters. Atlas always reads the notes and edges collections."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Search keywords for profile discovery."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum profile records or result rows returned."
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "md"
          ],
          "default": "md",
          "description": "Output format."
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "title": "MCP Atlas Owner",
      "description": "Handbook-style projections over notes, edges, topology, and view readiness.",
      "const": "mcp.tool.atlas"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "title": "list",
          "description": "Atlas query profile listing",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.atlas",
              "description": "MCP tool target."
            },
            "action": {
              "const": "list",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/list"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.atlas",
              "action": "list",
              "payload": {
                "limit": 20
              }
            }
          ],
          "readOnly": true
        },
        "search": {
          "title": "search",
          "description": "Atlas query profile keyword matches",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.atlas",
              "description": "MCP tool target."
            },
            "action": {
              "const": "search",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/search"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.atlas",
              "action": "search",
              "payload": {
                "keywords": [
                  "types"
                ],
                "limit": 5
              }
            }
          ],
          "readOnly": true
        },
        "describe": {
          "title": "describe",
          "description": "Atlas query profile contract",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.atlas",
              "description": "MCP tool target."
            },
            "action": {
              "const": "describe",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/describe"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.atlas",
              "action": "describe",
              "payload": {
                "target": "atlas.types"
              }
            }
          ],
          "readOnly": true
        },
        "call": {
          "title": "call",
          "description": "Atlas projection query result",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.atlas",
              "description": "MCP tool target."
            },
            "action": {
              "const": "call",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/call"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.atlas",
              "action": "call",
              "payload": {
                "target": "atlas.types",
                "params": {
                  "mode": "table",
                  "limit": 20
                }
              }
            }
          ],
          "readOnly": true
        }
      }
    },
