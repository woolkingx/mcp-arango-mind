{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-tool-database.schema.json",
  "title": "MCP Tool Database",
  "description": "search_tools first for params. Database: list(list databases) get_active(current database) get_focused(alias for get_active) switch(switch database profile) get_resolution(profile resolution chain) backup(backup collections) restore(restore from backup)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "payload"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "get_active",
        "get_focused",
        "switch",
        "get_resolution",
        "backup",
        "restore"
      ],
      "description": "Database operation to perform."
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Database action payload. Required fields depend on action and are enforced by the database owner.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Profile key for switch."
        },
        "database": {
          "type": "string",
          "description": "Alias for profile when switching."
        },
        "output_dir": {
          "type": "string",
          "description": "Backup output directory."
        },
        "input_dir": {
          "type": "string",
          "description": "Restore input directory."
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Collections to backup or restore."
        },
        "type": {
          "type": "string",
          "enum": [
            "collection",
            "graph",
            "view",
            "all"
          ],
          "description": "Backup type."
        },
        "conflict": {
          "type": "string",
          "enum": [
            "skip",
            "replace",
            "update"
          ],
          "default": "skip",
          "description": "Restore conflict policy."
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "md"
          ],
          "default": "md",
          "description": "Output format."
        }
      }
    }
  },
