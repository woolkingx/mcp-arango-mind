          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Maximum templates returned by list and search."
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "md"
            ],
            "default": "md",
            "description": "Output format."
          }
        },
        "description": "Payload for mcp.tool.template.list."
      },
      "search": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keywords"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "Template id '<category>.<name>' for describe and call (execute), or meta.create|meta.update|meta.remove|meta.validate for catalog ops."
          },
          "params": {
            "type": "object",
            "description": "Template bind vars for execute, or catalog op arguments for meta targets."
          },
          "keywords": {
