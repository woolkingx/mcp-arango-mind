{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-tool-template.schema.json",
  "title": "MCP Tool Template",
  "description": "Template catalog discovery, lifecycle, and execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "payload"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "search",
        "describe",
        "call"
      ],
      "description": "Small control verb for the template surface."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "description": "Template id '<category>.<name>' for describe and call (execute), or meta.create|meta.update|meta.remove|meta.validate for catalog ops."
        },
        "params": {
          "type": "object",
          "description": "Template bind vars for execute, or catalog op arguments for meta targets."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Search keywords for search."
        },
        "category": {
          "type": "string",
          "description": "Optional category filter for list."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum templates returned by list and search."
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "md"
          ],
          "default": "md",
          "description": "Output format."
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "title": "MCP Template Owner",
      "description": "Template catalog discovery, lifecycle, and execution.",
      "const": "mcp.tool.template"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "title": "list",
          "description": "Template catalog id listing",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.template",
              "description": "MCP tool target."
            },
            "action": {
              "const": "list",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/list"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.template",
              "action": "list",
              "payload": {
                "limit": 20
              }
            }
          ],
          "readOnly": true
        },
        "search": {
          "title": "search",
          "description": "Template catalog keyword matches",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.template",
              "description": "MCP tool target."
            },
            "action": {
              "const": "search",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/search"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.template",
              "action": "search",
              "payload": {
                "keywords": [
                  "memory"
                ],
                "limit": 5
              }
            }
          ],
          "readOnly": true
        },
        "describe": {
          "title": "describe",
          "description": "Template catalog entry",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.template",
              "description": "MCP tool target."
            },
            "action": {
              "const": "describe",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/describe"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.template",
              "action": "describe",
              "payload": {
                "target": "memory.view"
              }
            }
          ],
          "readOnly": true
        },
        "call": {
          "title": "call",
          "description": "Template execution result, catalog mutation, or validate report",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.tool.template",
              "description": "MCP tool target."
            },
            "action": {
              "const": "call",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/call"
            }
          },
          "examples": [
            {
              "target": "mcp.tool.template",
              "action": "call",
              "payload": {
                "target": "memory.view",
                "params": {
                  "query": "schema",
                  "limit": 5
                }
              }
            }
          ]
        }
      }
    },
    "payloads": {
      "list": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "target": {
            "type": "string",
