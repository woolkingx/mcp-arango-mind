            },
            "minItems": 1,
            "description": "Search keywords for search."
          },
          "category": {
            "type": "string",
            "description": "Optional category filter for list."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Maximum templates returned by list and search."
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
