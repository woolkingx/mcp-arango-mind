            },
            "action": {
              "const": "describe",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/describe"
            }
          },
          "examples": [
            {
              "target": "mcp.arango",
              "action": "describe",
              "payload": {
                "target": "getServerAvailability"
              }
            }
          ],
          "readOnly": true
        },
        "call": {
          "title": "call",
          "description": "Compatibility alias for exec",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.arango",
              "description": "MCP tool target."
            },
            "action": {
              "const": "call",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/call"
            }
          },
          "examples": [
            {
              "target": "mcp.arango",
              "action": "call",
              "payload": {
                "target": "getServerAvailability",
                "params": {}
              }
            }
          ]
        }
      }
    },
