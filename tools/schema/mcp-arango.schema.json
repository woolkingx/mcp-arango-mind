    "tool": {
      "title": "MCP Arango Surface",
      "description": "Search and execute ArangoDB OpenAPI operations without exposing hundreds of operations as separate tools.",
      "const": "mcp.arango"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "title": "list",
          "description": "ArangoDB OpenAPI operation summaries",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.arango",
              "description": "MCP tool target."
            },
            "action": {
              "const": "list",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/list"
            }
          },
          "examples": [
            {
              "target": "mcp.arango",
              "action": "list",
              "payload": {
                "limit": 20
              }
            }
          ],
          "readOnly": true
        },
        "search": {
          "title": "search",
          "description": "ArangoDB OpenAPI operation matches",
          "type": "object",
          "required": [
            "target",
            "action",
            "payload"
          ],
          "properties": {
            "target": {
              "const": "mcp.arango",
              "description": "MCP tool target."
            },
            "action": {
              "const": "search",
