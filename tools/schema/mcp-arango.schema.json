            },
            "action": {
              "const": "exec",
              "description": "Action name."
            },
            "payload": {
              "$ref": "#/$defs/payloads/exec"
            }
          },
          "examples": [
            {
              "target": "mcp.arango",
              "action": "exec",
              "payload": {
                "target": "getServerAvailability",
                "params": {}
              }
            }
          ]
        },
        "describe": {
          "title": "describe",
          "description": "ArangoDB OpenAPI operation contract",
          "type": "object",
          "required": [
            "target",
            "action",
