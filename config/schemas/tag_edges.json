{
  "name": "tag_edges",
  "collection": "tag_edges",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["_from", "_to", "op", "weight"],
    "properties": {
      "_from": {
        "type": "string",
        "pattern": "^tags/",
        "description": "Source tag vertex ID, such as tags/<key>."
      },
      "_to": {
        "type": "string",
        "pattern": "^tags/",
        "description": "Target tag vertex ID, such as tags/<key>."
      },
      "op": {
        "type": "string",
        "enum": ["AND", "OR", "NOT", "XOR", "PPR"],
        "description": "Quaternary logic operator classifying this edge."
      },
      "weight": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "description": "Edge strength from 1 to 64."
      },
      "confidence": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 0.5,
        "description": "Confidence score from 0 to 1."
      },
      "p_forward": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Forward conditional probability P(to|from)."
      },
      "p_backward": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Backward conditional probability P(from|to)."
      },
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Whether this edge is active in graph operations."
      },
      "source": {
        "type": "string",
        "description": "Origin, such as auto-sync, auto-ppr, or manual."
      },
      "behavior_score": {
        "type": "number",
        "minimum": 0.0,
        "description": "Behavior signal from access_logs."
      },
      "ppr_score": {
        "type": "number",
        "minimum": 0.0,
        "description": "Personalized PageRank score for op=PPR edges."
      },
      "created_at": {
        "type": "string",
        "description": "Creation timestamp in ISO 8601 format."
      },
      "updated_at": {
        "type": "string",
        "description": "Last update timestamp in ISO 8601 format."
      }
    },
    "additionalProperties": true,
    "x-methods": {
      "is_strong": {
        "properties": {
          "weight": { "minimum": 18 },
          "enabled": { "const": true }
        }
      },
      "is_noise": {
        "anyOf": [
          { "properties": { "weight": { "maximum": 12 } } },
          { "properties": { "confidence": { "exclusiveMaximum": 0.35 } } }
        ]
      },
      "is_quaternary": {
        "properties": {
          "op": { "enum": ["AND", "OR", "NOT", "XOR"] }
        }
      },
      "is_ppr": {
        "properties": {
          "op": { "const": "PPR" }
        }
      }
    },
    "x-tests": {
      "is_strong": ["min_boundary", "below_min", "valid_normal"],
      "is_noise": ["valid_normal", "valid_edge", "below_min"],
      "is_quaternary": ["valid_normal", "valid_edge"],
      "is_ppr": ["valid_normal", "missing"]
    },
    "x-docs": {
      "intent": "Edge in the tag knowledge graph. Represents a relationship between two tag concepts classified by quaternary logic operators.",
      "category": "graph",
      "notes": {
        "summary": "Three producers: sync_run creates AND/OR/NOT/XOR from PMI, optimize_run adjusts weight and confidence from behavior, and ppr_run creates PPR edges from PageRank. Weight range [1,64] and enable or disable thresholds are schema-enforceable constraints.",
        "auto_sources": ["auto", "auto-sync"],
        "auto_ppr_source": "auto-ppr",
        "ppr_op_multipliers": {
          "AND": 1.0,
          "OR": 0.5,
          "XOR": 0.3,
          "NOT": 0.0
        }
      }
    }
  }
}
